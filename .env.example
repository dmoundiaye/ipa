# ==========================================================
# API DEVNET - Configuration
# ==========================================================
# Copier ce fichier en .env et ajuster les valeurs:
#   cp .env.example .env

# === APPLICATION ===
APP_NAME=Network Equipment Inventory API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# === BASE DE DONNÉES ===
# Local (MySQL): mysql+pymysql://user:password@host:port/db
# Docker: mysql+pymysql://devnet:devnetpassword@mysql:3306/inventory
DATABASE_URL=mysql+pymysql://root:@localhost:3306/inventory
SQL_ECHO=false

# === SÉCURITÉ JWT ===
# IMPORTANT: Générer une clé sécurisée en production:
#   openssl rand -hex 32
SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === GNS3 ===
GNS3_URL=http://192.168.80.1:3080
GNS3_USERNAME=admin
GNS3_PASSWORD=changeme

# === RATE LIMITING ===
RATE_LIMIT_TOKEN=5/minute
RATE_LIMIT_DEFAULT=100/minute

# === RÉSILIENCE - RETRY ===
RETRY_MAX_ATTEMPTS=3
RETRY_MIN_WAIT=1
RETRY_MAX_WAIT=10

# === LOGGING ===
LOG_LEVEL=DEBUG